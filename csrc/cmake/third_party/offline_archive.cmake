include_guard(GLOBAL)

set(_VLLM_ASCEND_ARCHIVE_DIR "${CMAKE_CURRENT_LIST_DIR}/archives")

function(vllm_ascend_dependency_url output filename fallback)
    set(_checksum_file "${_VLLM_ASCEND_ARCHIVE_DIR}/SHA256SUMS")
    if(NOT EXISTS "${_checksum_file}")
        message(FATAL_ERROR "Missing build dependency checksum manifest: ${_checksum_file}")
    endif()
    file(STRINGS "${_checksum_file}" _checksums)
    set(_expected "")
    foreach(_entry IN LISTS _checksums)
        string(REGEX MATCH "^([0-9a-f]+)  ([^ ]+)$" _match "${_entry}")
        if(_match AND "${CMAKE_MATCH_2}" STREQUAL "${filename}")
            if(NOT "${_expected}" STREQUAL "")
                message(FATAL_ERROR "Duplicate build dependency checksum: ${filename}")
            endif()
            set(_expected "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    string(LENGTH "${_expected}" _checksum_length)
    if(NOT _checksum_length EQUAL 64)
        message(FATAL_ERROR "Missing or invalid build dependency SHA256: ${filename}")
    endif()

    set(_archive "${_VLLM_ASCEND_ARCHIVE_DIR}/${filename}")
    if(EXISTS "${_archive}")
        file(SHA256 "${_archive}" _actual)
        if(NOT "${_actual}" STREQUAL "${_expected}")
            message(FATAL_ERROR "Build dependency SHA256 mismatch: ${_archive}; restore the archive from this branch")
        endif()
        message(STATUS "Using bundled build dependency: ${filename}")
        set(${output} "${_archive}" PARENT_SCOPE)
    else()
        message(STATUS "Bundled build dependency ${filename} is absent; using ${fallback}")
        set(${output} "${fallback}" PARENT_SCOPE)
    endif()
    set(${output}_SHA256 "${_expected}" PARENT_SCOPE)
endfunction()
