+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import random
+import unittest
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+from runtime_contracts import RequestStatus, load_scheduler
+from source_modules import balance_load, load_source
+
+wire = load_source("dyntra_lb_wire")
+
+
+class CompactSnapshotTests(unittest.TestCase):
+    def test_round_trip_and_planner_equivalence(self):
+        snapshots = [([12, 50000, 7, 4], 2, True), ([], 0, False), ([3, 3, 400], 1, False)]
+        decoded = [wire.decode_snapshot(wire.encode_snapshot(*row)) for row in snapshots]
+        self.assertEqual(decoded, snapshots)
+        original = [(blocks, split) for blocks, split, _ in snapshots]
+        restored = [(blocks, split) for blocks, split, _ in decoded]
+        self.assertEqual(balance_load(original, 3, max_num_seqs=2, with_request_indices=True),
+                         balance_load(restored, 3, max_num_seqs=2, with_request_indices=True))
+        self.assertLess(len(wire.encode_snapshot([20] * 8, 4, False)), (256 * 2 + 2) * 4)
+
+    def test_randomized_plans_preserve_slot_identity(self):
+        rng = random.Random(12292)
+        for _ in range(250):
+            snapshots = []
+            for _rank in range(8):
+                running = rng.randrange(5)
+                waiting = rng.randrange(5)
+                blocks = [rng.randint(1, 100000) for _ in range(running + waiting)]
+                snapshots.append((blocks, running, bool(rng.randrange(2))))
+            decoded = [wire.decode_snapshot(wire.encode_snapshot(*row)) for row in snapshots]
+            self.assertEqual(decoded, snapshots)
+            padded = [(blocks + [0] * (8 - len(blocks)), split) for blocks, split, _ in snapshots]
+            compact = [(blocks, split) for blocks, split, _ in decoded]
+            self.assertEqual(balance_load(padded, 8, max_num_seqs=4, with_request_indices=True),
+                             balance_load(compact, 8, max_num_seqs=4, with_request_indices=True))
+
+    def test_invalid_payloads(self):
+        for payload in (b"", b"\x00\x80", b"\x00\x02", b"\x01\x00"):
+            with self.subTest(payload=payload), self.assertRaises(ValueError):
+                wire.decode_snapshot(payload)
+
+    def test_prefetch_only_selected_and_retry_after_failure(self):
+        scheduler_class, _ = load_scheduler()
+        scheduler = scheduler_class(vllm_config=SimpleNamespace(additional_config={}))
+        scheduler._lb_kv_prefetch_enabled = True
+        scheduler.connector = MagicMock()
+        scheduler.connector.get_num_new_matched_tokens.return_value = (8, True)
+        scheduler.kv_cache_manager = MagicMock()
+        scheduler.kv_cache_manager.get_computed_blocks.return_value = ([], 0, 0)
+        scheduler.kv_cache_manager.allocate_slots.return_value = None
+        scheduler.scheduler_reserve_full_isl = False
+        first = SimpleNamespace(request_id="selected", status=RequestStatus.WAITING, num_computed_tokens=0)
+        second = SimpleNamespace(request_id="other", status=RequestStatus.WAITING, num_computed_tokens=0)
+        scheduler.waiting.items = [first, second]
+        self.assertEqual(scheduler._run_lb_kv_prefetch({"selected"}), {"selected"})
+        self.assertEqual(scheduler.connector.get_num_new_matched_tokens.call_count, 1)
+        self.assertIs(scheduler.connector.get_num_new_matched_tokens.call_args.args[0], first)
+        self.assertEqual(first.num_computed_tokens, 0)
+        self.assertEqual(second.num_computed_tokens, 0)
+        self.assertEqual(scheduler._run_lb_kv_prefetch(set()), set())
+        self.assertEqual(scheduler.connector.get_num_new_matched_tokens.call_count, 1)
+
+    def test_selected_async_prefetch_moves_only_that_request(self):
+        class HashableRequest(SimpleNamespace):
+            __hash__ = object.__hash__
+
+        scheduler_class, _ = load_scheduler()
+        scheduler = scheduler_class(vllm_config=SimpleNamespace(additional_config={}))
+        scheduler._lb_kv_prefetch_enabled = True
+        scheduler.connector = MagicMock()
+        scheduler.connector.get_num_new_matched_tokens.return_value = (8, True)
+        scheduler.kv_cache_manager = MagicMock()
+        scheduler.kv_cache_manager.get_computed_blocks.return_value = ([], 0, 0)
+        scheduler.kv_cache_manager.allocate_slots.return_value = object()
+        scheduler.scheduler_reserve_full_isl = False
+        scheduler._inflight_prefills = set()
+        selected = HashableRequest(request_id="selected", status=RequestStatus.WAITING, num_computed_tokens=0)
+        other = HashableRequest(request_id="other", status=RequestStatus.WAITING, num_computed_tokens=0)
+        scheduler.waiting.items = [selected, other]
+        self.assertEqual(scheduler._run_lb_kv_prefetch({"selected"}), set())
+        self.assertEqual(selected.status, RequestStatus.WAITING_FOR_REMOTE_KVS)
+        self.assertEqual(selected.num_computed_tokens, 8)
+        self.assertEqual(list(scheduler.skipped_waiting), [selected])
+        self.assertEqual(list(scheduler.waiting), [other])
+        self.assertEqual(scheduler._inflight_prefills, {selected})
+        scheduler.connector.update_state_after_alloc.assert_called_once()
+
+
+if __name__ == "__main__":
+    unittest.main()
